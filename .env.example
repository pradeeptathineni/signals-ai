# Safe local defaults. Signals binds only to loopback. Existing database resources keep their names.
DATABASE_URL=postgres://maestro:maestro@127.0.0.1:54329/maestro
SIGNALS_HOST=127.0.0.1
SIGNALS_PORT=4310
SIGNALS_RATE_LIMIT_MAX=120
SIGNALS_WEB_ORIGIN=http://127.0.0.1:5173
SIGNALS_LOG_LEVEL=info
SIGNALS_ALLOW_NETWORK_FETCH=false
