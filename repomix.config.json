{
  "output": {
    "filePath": ".codex/context-cache/maestro-context.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "headerText": "Disposable map for Signals. Source files and tests remain authoritative. Git JSON is the public Corpus database; private .signals files are never included.",
    "fileSummary": true,
    "directoryStructure": true,
    "compress": true,
    "patterns": [
      {
        "pattern": "AGENTS.md"
      },
      {
        "pattern": "README.md"
      },
      {
        "pattern": "package.json"
      },
      {
        "pattern": "docs/architecture/**/*.md"
      }
    ],
    "topFilesLength": 10,
    "truncateBase64": true,
    "tokenBudget": 30000,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "package.json",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*",
    "docs/architecture/**/*.md"
  ],
  "ignore": {
    "useGitignore": false,
    "useDotIgnore": false,
    "useDefaultPatterns": false,
    "customPatterns": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "packages/test-fixtures/**",
      "packages/domain/src/public-index.ts",
      "packages/domain/src/url.ts",
      "scripts/run-context-pack.test.mjs",
      "scripts/dependency-audit-policy.test.mjs",
      ".signals/**",
      "**/dist/**",
      "**/node_modules/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
